<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="ultimateautomizer" displayName="UAutomizer" timelimit="1 min" hardtimelimit="2 min" memlimit="4 GB" cpuCores="4">

  <require cpuModel="Intel Xeon E3-1230 v5 @ 3.40 GHz" />

  <resultfiles>**/witness.*</resultfiles>

  <option name="--full-output" />

  <tasks name="argc-benchmarks">
    <includesfile>../sv-benchmarks/c/argc-benchmarks/unreach-call.set</includesfile>
  </tasks>

  <rundefinition name="unreach-call">
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
  </rundefinition>
  <rundefinition name="valid-memsafety">
      <propertyfile>../sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
  </rundefinition>
  <rundefinition name="no-overflow">
      <propertyfile>../sv-benchmarks/c/properties/no-overflow.prp</propertyfile>
  </rundefinition>
  <rundefinition name="termination">
      <propertyfile>../sv-benchmarks/c/properties/termination.prp</propertyfile>
  </rundefinition>

</benchmark>
