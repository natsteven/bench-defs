<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="esbmc" displayName="LF-checker" timelimit="15 min" hardtimelimit="16 min" memlimit="15 GB" cpuCores="4">

  <require cpuModel="Intel Xeon E3-1230 v5 @ 3.40 GHz" />

  <resultfiles>**/witness.*</resultfiles>

  <option name="--concurrencyFlagPredictor" />
  <option name="DT2.sav" />

  <rundefinition name="SV-COMP26_unreach-call">
    <tasks name="C.unreach-call.Concurrency">
      <includesfile>../sv-benchmarks/c/Concurrency.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>

    </rundefinition>

  <rundefinition name="SV-COMP26_no-data-race">
    <tasks name="C.no-data-race.Concurrency">
      <includesfile>../sv-benchmarks/c/Concurrency.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/no-data-race.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_valid-memsafety">
    <tasks name="C.valid-memsafety.Concurrency">
      <includesfile>../sv-benchmarks/c/Concurrency.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_no-overflow">
    <tasks name="C.no-overflow.Concurrency">
      <includesfile>../sv-benchmarks/c/Concurrency.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/no-overflow.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_unreach-call_demo">
    <tasks name="C.unreach-call.Huawei-Concurrency-Challenges">
      <includesfile>../sv-benchmarks/c/Huawei-Concurrency-Challenges.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>

    </rundefinition>

  <rundefinition name="SV-COMP26_no-data-race_demo">
    <tasks name="C.no-data-race.Huawei-Concurrency-Challenges">
      <includesfile>../sv-benchmarks/c/Huawei-Concurrency-Challenges.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/no-data-race.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_valid-memsafety_demo">
    <tasks name="C.valid-memsafety.Huawei-Concurrency-Challenges">
      <includesfile>../sv-benchmarks/c/Huawei-Concurrency-Challenges.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_no-overflow_demo">
    <tasks name="C.no-overflow.Huawei-Concurrency-Challenges">
      <includesfile>../sv-benchmarks/c/Huawei-Concurrency-Challenges.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/no-overflow.prp</propertyfile>
    </tasks>
  </rundefinition>


</benchmark>