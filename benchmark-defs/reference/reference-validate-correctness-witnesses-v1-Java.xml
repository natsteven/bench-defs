<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="{toolinfo_name}" displayName="{name}" timelimit="5 min" hardtimelimit="6 min" memlimit="7 GB" cpuCores="2">

  <require cpuModel="Intel Xeon E3-1230 v5 @ 3.40 GHz"/>

  <resultfiles>**/witness.*</resultfiles>

{benchexec_toolinfo_options}

  <rundefinition name="SV-COMP26_valid-assert">
    <requiredfiles>../results-verified/LOGDIR/${rundefinition_name}/${taskdef_name}/witness.graphml</requiredfiles>
{witness_options}

    <tasks name="Java.valid-assert.Main">
      <includesfile>../sv-benchmarks/java/ReachSafety-Java.set</includesfile>
      <propertyfile>../sv-benchmarks/java/properties/valid-assert.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP26_no-runtime-exception">
    <requiredfiles>../results-verified/LOGDIR/${rundefinition_name}/${taskdef_name}/witness.graphml</requiredfiles>
{witness_options}

    <tasks name="Java.no-runtime-exception.Main">
      <includesfile>../sv-benchmarks/java/ReachSafety-Java.set</includesfile>
      <propertyfile>../sv-benchmarks/java/properties/no-runtime-exception.prp</propertyfile>
    </tasks>
  </rundefinition>

{extension}
</benchmark>